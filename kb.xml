<?xml version="1.0" encoding="UTF-8"?>
<knowledge>
  <title>Scuba diving knowledge system</title>
  <description>This knowledge base determines whether a diver can go into the water safely.</description>

  <goal name="canDive">
    <description>Can the diver go into the water safely?</description>
    <answer value="yes"><![CDATA[The diver <em>can</em> go into the water safely.]]></answer>
    <answer value="no">The diver cannot go into the water safely.</answer>
  </goal>

  <rules>
    <!-- Diver -->
    <rule>
      <if>
        <fact name="diver.healthy">no</fact>
      </if>
      <then>
        <fact name="canDive">no</fact>
        <fact name="reason">You are not in good health.</fact>
      </then>
    </rule>
    <rule>
      <if>
        <or>
          <fact name="diver.fever">yes</fact>
          <fact name="diver.sinusProblems">yes</fact>
          <fact name="diver.earPain">yes</fact>
        </or>
      </if>
      <then>
        <fact name="diver.healthy">no</fact>
      </then>
    </rule>
    <rule>
      <if>
        <not>
          <fact name="diver.bloodPressure">normal</fact>
        </not>
      </if>
      <then>
        <fact name="canDive">no</fact>
        <fact name="reason">Your blood pressure is not normal.</fact>
      </then>
    </rule>
    <rule>
      <if>
        <fact name="diver.energised">no</fact>
      </if>
      <then>
        <fact name="canDive">no</fact>
        <fact name="reason">You don't have high energy.</fact>
      </then>
    </rule>
    <rule>
      <if>
        <or>
          <fact name="diver.tired">yes</fact>
          <fact name="diver.hydrated">no</fact>
          <not>
            <fact name="diver.satiety">satisfied</fact>
          </not>
          <fact name="diver.hungover">yes</fact>
        </or>
      </if>
      <then>
        <fact name="diver.energised">no</fact>
      </then>
    </rule>
    <rule>
      <if>
        <fact name="diver.underInfluence">yes</fact>
      </if>
      <then>
        <fact name="canDive">no</fact>
        <fact name="reason">You are under the influence of drugs or alcohol.</fact>
      </then>
    </rule>

    <!-- Gear -->
    <rule>
      <if>
        <fact name="gear.maskFits">no</fact>
      </if>
      <then>
        <fact name="canDive">no</fact>
        <fact name="reason">You need a proper fitting mask that seals well.</fact>
      </then>
    </rule>
    <rule>
      <if>
        <fact name="gear.canHoldNose">no</fact>
      </if>
      <then>
        <fact name="canDive">no</fact>
        <fact name="reason">You need a to be able to hold your nose.</fact>
      </then>
    </rule>
    <rule>
      <if>
        <fact name="gear.finBootSizeCorrect">no</fact>
      </if>
      <then>
        <fact name="canDive">no</fact>
        <fact name="reason">Your fins and boots need to be the correct size.</fact>
      </then>
    </rule>
    <rule>
      <if>
        <and>
          <fact name="gear.needsDrysuitZipped">yes</fact>
          <fact name="gear.isDrysuitZipped">no</fact>
        </and>
      </if>
      <then>
        <fact name="canDive">no</fact>
        <fact name="reason">Your drysuit needs to be fully zipped up.</fact>
      </then>
    </rule>
    <rule>
      <if>
        <and>
          <fact name="gear.drysuitCanHaveHoles">no</fact>
          <fact name="gear.drysuitHasHoles">yes</fact>
        </and>
      </if>
      <then>
        <fact name="canDive">no</fact>
        <fact name="reason">Your drysuit should not have any holes.</fact>
      </then>
    </rule>
    <rule>
      <if>
        <fact name="gear.suitType">dry</fact>
      </if>
      <then>
        <fact name="gear.needsDrysuitZipped">yes</fact>
        <fact name="gear.drysuitCanHaveHole">no</fact>
      </then>
    </rule>
    <rule>
      <if>
        <and>
          <fact name="gear.wetsuitNeedsToFit">yes</fact>
          <fact name="gear.wetsuitFits">no</fact>
        </and>
      </if>
      <then>
        <fact name="canDive">no</fact>
        <fact name="reason">Your wetsuit needs to fit properly.</fact>
      </then>
    </rule>
    <rule>
      <if>
        <fact name="gear.suitType">wet</fact>
      </if>
      <then>
        <fact name="gear.wetsuitNeedsToFit">yes</fact>
      </then>
    </rule>
    <rule>
      <if>
        <not>
          <fact name="gear.bcdWorksCorrectly">bothWork</fact>
        </not>
      </if>
      <then>
        <fact name="canDive">no</fact>
        <fact name="reason">Your BCD needs to inflate and deflate correctly.</fact>
      </then>
    </rule>
    <rule>
      <if>
        <fact name="gear.primaryRegulatorWorks">no</fact>
      </if>
      <then>
        <fact name="canDive">no</fact>
        <fact name="reason">Your primary regulator needs to work correctly.</fact>
      </then>
    </rule>
    <rule>
      <if>
        <fact name="gear.octopusWorks">no</fact>
      </if>
      <then>
        <fact name="canDive">no</fact>
        <fact name="reason">Your octopus needs to work correctly.</fact>
      </then>
    </rule>
    <rule>
      <if>
        <not>
          <fact name="gear.tankPressure">enough</fact>
        </not>
      </if>
      <then>
        <fact name="canDive">no</fact>
        <fact name="reason">Your tank pressure needs to be at least 200 bar.</fact>
      </then>
    </rule>
    <rule>
      <if>
        <or>
          <fact name="plan.divingDepth">upTo20</fact>
          <fact name="plan.divingDepth">20-30</fact>
          <fact name="plan.divingDepth">30-40</fact>
        </or>
      </if>
      <then>
        <fact name="gear.tankContentNeeded">air</fact>
      </then>
    </rule>
    <rule>
      <if>
        <fact name="plan.divingDepth">deeperThan40</fact>
      </if>
      <then>
        <fact name="gear.tankContentNeeded">gasMix</fact>
      </then>
    </rule>
    <rule>
      <if>
        <and>
          <fact name="gear.tankContentNeeded">air</fact>
          <not>
            <fact name="gear.tankContent">air</fact>
          </not>
        </and>
      </if>
      <then>
        <fact name="canDive">no</fact>
        <fact name="reason">You need to have air in your air tank for dives up to 40 metres deep.</fact>
      </then>
    </rule>
    <rule>
      <if>
        <and>
          <fact name="gear.tankContentNeeded">gasMix</fact>
          <not>
            <fact name="gear.tankContent">gasMix</fact>
          </not>
        </and>
      </if>
      <then>
        <fact name="canDive">no</fact>
        <fact name="reason">You need to have gas mix in your air tank for dives deeper than 40 metres.</fact>
      </then>
    </rule>
    <rule>
      <if>
        <or>
          <and>
            <fact name="gear.weightsNeeded">8</fact>
            <not>
              <fact name="gear.weights">8</fact>
            </not>
          </and>
          <and>
            <fact name="gear.weightsNeeded">10-12</fact>
            <not>
              <fact name="gear.weights">10-12</fact>
            </not>
          </and>
        </or>
      </if>
      <then>
        <fact name="canDive">no</fact>
        <fact name="reason">You need to have the proper weights for your body weight. If you weigh less than 80 kilograms you should have 8 kilograms in weights, if you weigh more then you should have between 10 and 12 kilograms in weights.</fact>
      </then>
    </rule>
    <rule>
      <if>
        <fact name="diver.bodyWeight">under80</fact>
      </if>
      <then>
        <fact name="gear.weightsNeeded">8</fact>
      </then>
    </rule>
    <rule>
      <if>
        <fact name="diver.bodyWeight">atLeast80</fact>
      </if>
      <then>
        <fact name="gear.weightsNeeded">10-12</fact>
      </then>
    </rule>
    <rule>
      <if>
        <fact name="gear.computerCharged">no</fact>
      </if>
      <then>
        <fact name="canDive">no</fact>
        <fact name="reason">Your dive computer needs to have enough charge for how long you will be diving. For a 20 minute dive it needs at least 50% battery, for a 30 minute dive at least 70% battery, for a 45 minute dive at least 85% battery and for a dive of 1 hour at least 100% battery.</fact>
      </then>
    </rule>
    <rule>
      <if>
        <or>
          <and>
            <fact name="plan.maxDivingTime">20</fact>
            <not>
              <or>
                <fact name="gear.computerChargeLevel">50</fact>
                <fact name="gear.computerChargeLevel">70</fact>
                <fact name="gear.computerChargeLevel">85</fact>
                <fact name="gear.computerChargeLevel">100</fact>
              </or>
            </not>
          </and>
          <and>
            <fact name="plan.maxDivingTime">30</fact>
            <not>
              <or>
                <fact name="gear.computerChargeLevel">70</fact>
                <fact name="gear.computerChargeLevel">85</fact>
                <fact name="gear.computerChargeLevel">100</fact>
              </or>
            </not>
          </and>
          <and>
            <fact name="plan.maxDivingTime">45</fact>
            <not>
              <or>
                <fact name="gear.computerChargeLevel">85</fact>
                <fact name="gear.computerChargeLevel">100</fact>
              </or>
            </not>
          </and>
          <and>
            <fact name="plan.maxDivingTime">60</fact>
            <not>
              <fact name="gear.computerChargeLevel">100</fact>
            </not>
          </and>
        </or>
      </if>
      <then>
        <fact name="gear.computerCharged">no</fact>
      </then>
    </rule>
    <rule>
      <if>
        <fact name="gear.spgPressureGaugeWorking">no</fact>
      </if>
      <then>
        <fact name="canDive">no</fact>
        <fact name="reason">Your SPG pressure gauge needs to work correctly and show the pressure in your air tank.</fact>
      </then>
    </rule>
    <rule>
      <if>
        <fact name="gear.surfaceMarkerBuoyAvailable">no</fact>
      </if>
      <then>
        <fact name="canDive">no</fact>
        <fact name="reason">There has to be a surface marker buoy available.</fact>
      </then>
    </rule>

    <!-- Environment -->
    <rule>
      <if>
        <and>
          <fact name="env.wind">no</fact>
          <fact name="env.storm">3+</fact>
        </and>
      </if>
      <then>
        <fact name="env.isWeatherAppropriate">yes</fact>
      </then>
    </rule>
    <rule>
      <if>
        <not>
          <fact name="env.isWeatherAppropriate">yes</fact>
        </not>
      </if>
      <then>
        <fact name="canDive">no</fact>
        <fact name="reason">The weather conditions are not suitable for diving.</fact>
      </then>
    </rule>
    <rule>
      <if>
        <and>
          <fact name="env.wave">1.0-1.5</fact>
          <not>
            <fact name="diver.expertise">expert</fact>
          </not>
        </and>
      </if>
      <then>
        <fact name="plan.hasEnoughExpertiseForWave">no</fact>
      </then>
    </rule>
    <rule>
      <if>
        <or>
          <fact name="plan.hasEnoughExpertiseForWave">no</fact>
          <fact name="env.wave">1.5+</fact> <!--No one can safely dive with this wave-->
        </or>
      </if>
      <then>
        <fact name="canDive">no</fact>
        <fact name="reason">The wave height is too high for safe diving.</fact>
      </then>
    </rule>
    <rule>
      <if>
        <fact name="env.visibility">poor</fact>
      </if>
      <then>
        <fact name="canDive">no</fact>
        <fact name="reason">The water visibility is too poor for safe diving.</fact>
      </then>
    </rule>

    <!-- Plan -->
    <rule>
      <if>
        <and>
          <fact name="plan.divingDepth">upTo20</fact>
          <fact name="plan.bottomTimePlan">45+</fact>
        </and>
      </if>
      <then>
        <fact name="canDive">no</fact>
        <fact name="reason">For a dive up to 20 metres deep you should not plan to stay longer than 45 minutes at the maximum depth.</fact>
      </then>
    </rule>
    <rule>
      <if>
        <and>
          <fact name="plan.divingDepth">20-30</fact>
          <or>
            <fact name="plan.bottomTimePlan">20-45</fact>
            <fact name="plan.bottomTimePlan">45+</fact>
          </or>
        </and>
      </if>
      <then>
        <fact name="canDive">no</fact>
        <fact name="reason">For a dive between 20 and 30 metres deep you should not plan to stay longer than 20 minutes at the maximum depth.</fact>
      </then>
    </rule>
    <rule>
      <if>
        <and>
          <fact name="plan.divingDepth">30-40</fact>
          <or>
            <fact name="plan.bottomTimePlan">10-20</fact>
            <fact name="plan.bottomTimePlan">20-45</fact>
            <fact name="plan.bottomTimePlan">45+</fact>
          </or>
        </and>
      </if>
      <then>
        <fact name="canDive">no</fact>
        <fact name="reason">For a dive between 30 and 40 metres deep you should not plan to stay longer than 10 minutes at the maximum depth.</fact>
      </then>
    </rule>
    <rule>
      <if>
        <fact name="plan.airConsumptionCalculated">no</fact>
      </if>
      <then>
        <fact name="canDive">no</fact>
        <fact name="reason">You must calculate your air consumption for this dive beforehand.</fact>
      </then>
    </rule>
    <rule>
      <if>
        <fact name="plan.haveBuddy">no</fact>
      </if>
      <then>
        <fact name="canDive">no</fact>
        <fact name="reason">You need to have a dive buddy with you. You can't dive alone.</fact>
      </then>
    </rule>
    <rule>
      <if>
        <fact name="plan.navigationPlan">no</fact>
      </if>
      <then>
        <fact name="canDive">no</fact>
        <fact name="reason">You need to have a navigation plan for your dive.</fact>
      </then>
    </rule>
  </rules>

  <questions>
    <!-- Diver -->
    <!-- Health -->
    <question name="diver.fever">
      <description>Do you currently have a fever?</description>
      <answers>
        <answer value="yes">Yes</answer>
        <answer value="no">No</answer>
      </answers>
    </question>
    <question name="diver.sinusProblems">
      <description>Are you experiencing sinus problems?</description>
      <answers>
        <answer value="yes">Yes</answer>
        <answer value="no">No</answer>
      </answers>
    </question>
    <question name="diver.earPain">
      <description>Are you currently experiencing pain in your ear?</description>
      <answers>
        <answer value="yes">Yes</answer>
        <answer value="no">No</answer>
      </answers>
    </question>
    <!-- Blood pressure -->
     <question name="diver.bloodPressure">
      <description>What is your current blood pressure?</description>
      <answers>
        <answer value="low">Lower than 125/75</answer>
        <answer value="normal">125/75</answer>
        <answer value="high">Higher than 125/75</answer>
      </answers>
    </question>
    <!-- Energy -->
    <question name="diver.tired">
      <description>Are you feeling tired?</description>
      <answers>
        <answer value="yes">Yes</answer>
        <answer value="no">No</answer>
      </answers>
    </question>
    <question name="diver.hydrated">
      <description>Have you had enough to drink?</description>
      <answers>
        <answer value="yes">Yes</answer>
        <answer value="no">No</answer>
      </answers>
    </question>
    <question name="diver.satiety">
      <description>How much have you eaten?</description>
      <answers>
        <answer value="hungry">I'm hungry</answer>
        <answer value="satisfied">I'm satisfied</answer>
        <answer value="overfull">I feel stuffed, ate too much</answer>
      </answers>
    </question>
    <question name="diver.hungover">
      <description>Are you currently hungover?</description>
      <answers>
        <answer value="yes">Yes</answer>
        <answer value="no">No</answer>
      </answers>
    </question>
    <!-- Influence -->
    <question name="diver.underInfluence">
      <description>Are you currently under the unfluence of drugs or alcohol?</description>
      <answers>
        <answer value="yes">Yes</answer>
        <answer value="no">No</answer>
      </answers>
    </question>

    <!-- Gear -->
    <!-- Mask -->
    <question name="gear.maskFits">
      <description>Does your mask fit properly and is it fully sealed?</description>
      <answers>
        <answer value="yes">Yes</answer>
        <answer value="no">No</answer>
      </answers>
    </question>
    <question name="gear.canHoldNose">
      <description>Are you able to hold your nose to regulate pressure?</description>
      <answers>
        <answer value="yes">Yes</answer>
        <answer value="no">No</answer>
      </answers>
    </question>
    <!-- Fins and boots size -->
    <question name="gear.finBootSizeCorrect">
      <description>Do your fins and boots fit you correctly?</description>
      <answers>
        <answer value="yes">Yes</answer>
        <answer value="no">No</answer>
      </answers>
    </question>
    <!-- Suit -->
    <question name="gear.suitType">
      <description>What kind of suit are you wearing?</description>
      <answers>
        <answer value="dry">Drysuit</answer>
        <answer value="wet">Wetsuit</answer>
      </answers>
    </question>
    <question name="gear.isDrysuitZipped">
      <description>Is your drysuit fully zipped up?</description>
      <answers>
        <answer value="yes">Yes</answer>
        <answer value="no">No</answer>
      </answers>
    </question>
    <question name="gear.drysuitHasHoles">
      <description>Are there any holes in your drysuit?</description>
      <answers>
        <answer value="yes">Yes</answer>
        <answer value="no">No</answer>
      </answers>
    </question>
    <question name="gear.wetsuitFits">
      <description>Does your wetsuit fit you correctly?</description>
      <answers>
        <answer value="yes">Yes</answer>
        <answer value="no">No</answer>
      </answers>
    </question>
    <!-- Buoyancy control device -->
    <question name="gear.bcdWorksCorrectly">
      <description>Does your BCD (buoyancy control device) inflate and deflate correctly?</description>
      <answers>
        <answer value="bothBroken">Inflating and deflating don't work correctly</answer>
        <answer value="inflatingBroken">Inflating doesn't work correctly</answer>
        <answer value="deflatingBroken">Deflating doesn't work correctly</answer>
        <answer value="bothWork">Inflating and deflating both work correctly</answer>
      </answers>
    </question>
    <!-- Regulator -->
    <question name="gear.primaryRegulatorWorks">
      <description>Does your primary regulator work?</description>
      <answers>
        <answer value="yes">Yes</answer>
        <answer value="no">No</answer>
      </answers>
    </question>
    <question name="gear.octopusWorks">
      <description>Does your octopus work?</description>
      <answers>
        <answer value="yes">Yes</answer>
        <answer value="no">No</answer>
      </answers>
    </question>
    <!-- Tank -->
    <question name="gear.tankPressure">
      <description>What is the current pressure of your air tank?</description>
      <answers>
        <answer value="enough">200 bars or more</answer>
        <answer value="less">less than 200 bars</answer>
      </answers>
    </question>
    <question name="plan.divingDepth">
      <description>How deep do you intend to dive?</description>
      <answers>
        <answer value="upTo20">Up to 20 metres</answer>
        <answer value="20-30">20 to 30 metres</answer>
        <answer value="30-40">30 to 40 metres</answer>
        <answer value="deeperThan40">Deeper than 40 metres</answer>
      </answers>
    </question>
    <question name="gear.tankContent">
      <description>What do you have in your air tank?</description>
      <answers>
        <answer value="air">Air</answer>
        <answer value="gasMix">Gas mix</answer>
      </answers>
    </question>
    <!-- Weights -->
    <question name="diver.bodyWeight">
      <description>What is your body weight?</description>
      <answers>
        <answer value="under80">Under 80 kilograms</answer>
        <answer value="atLeast80">80 kilograms or more</answer>
      </answers>
    </question>
    <question name="gear.weights">
      <description>How many weights have you taken?</description>
      <answers>
        <answer value="8">8 kilograms in weights</answer>
        <answer value="10-12">10-12 kilograms in weights</answer>
      </answers>
    </question>
    <!-- Dive computer -->
    <question name="plan.maxDivingTime">
      <description>How long will you dive for at most?</description>
      <answers>
        <answer value="20">At most 20 minutes</answer>
        <answer value="30">At most 30 minutes</answer>
        <answer value="45">At most 45 minutes</answer>
        <answer value="60">At most 1 hour</answer>
      </answers>
    </question>
    <question name="gear.computerChargeLevel">
      <description>What is the charge level of your dive computer?</description>
      <answers>
        <answer value="50">At least 50%</answer>
        <answer value="70">At least 70%</answer>
        <answer value="85">At least 85%</answer>
        <answer value="100">At least 100%</answer>
      </answers>
    </question>
    <!-- SPG pressure gauge -->
    <question name="gear.spgPressureGaugeWorking">
      <description>Is your SPG pressurue gauge working (showing 200 bars)?</description>
      <answers>
        <answer value="yes">Yes</answer>
        <answer value="no">No</answer>
      </answers>
    </question>
    <!-- Surface marker buoy -->
    <question name="gear.surfaceMarkerBuoyAvailable">
      <description>Is a surface marker buoy available?</description>
      <answers>
        <answer value="yes">Yes</answer>
        <answer value="no">No</answer>
      </answers>
    </question>
    <!-- Environment -->
    <!-- Weather conditions -->
    <question name = "env.wind">
      <description>Is the wind strong?</description>
      <answers>
        <answer value="yes">Yes</answer>
        <answer value="no">No</answer>
      </answers>
    </question>
    <question name = "env.storm">
      <description>When was the last storm?</description>
      <answers>
        <answer value="3+">Over three days ago</answer>
        <answer value="3-">Less than three days ago</answer>
      </answers>
    </question>
    <!-- Wave height -->
    <question name="env.wave">
      <description>What is the height of the waves?</description>
      <answers>
        <answer value="0-0.5">Up to 0.5 metres</answer>
        <answer value="0.5-1.0">0.5 to 1 metre</answer>
        <answer value="1.0-1.5">1 to 1.5 metres</answer>
        <answer value="1.5+">Over 1.5 metres</answer>
      </answers>
    </question>
    <question name="diver.expertise">
      <description>What is your level of expertise in diving?</description>
      <answers>
        <answer value="beginner">Beginner</answer>
        <answer value="intermediate">Intermediate</answer>
        <answer value="expert">Expert</answer>
      </answers>
    </question>
    <!-- Water visibility -->
    <question name="env.visibility">
      <description>What is the water visibility?</description>
      <answers>
        <answer value="poor">Poor (less than 10 metres)</answer>
        <answer value="good">Good (over 10 metres)</answer>
      </answers>
    </question>
    <!-- Dive plan -->
    <question name="plan.bottomTimePlan">
      <description>How long do you plan to stay at the maximum depth?</description>
      <answers>
        <answer value="10">10 minutes or less</answer>
